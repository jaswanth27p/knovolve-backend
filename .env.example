# backend/.env — copy to `.env` and fill in. Safe to commit: no real secrets here.
#
# This one file is read by TWO consumers, which is why it mixes app settings
# with container passwords:
#   1. app/config.py (pydantic-settings, `env_file = ".env"`) — the lowercase
#      Settings fields below.
#   2. docker compose — the `${VAR}` interpolations in docker-compose.yml.
# Settings deliberately sets `extra = "ignore"` so the compose-only vars here
# don't blow up app import; see the comment at that line in app/config.py.
#
# The langfuse-* containers are behind a compose profile, so none of the
# LANGFUSE_* vars below are needed for plain `docker compose up -d`. They are
# only required for `docker compose --profile langfuse up -d`.

# --- app settings (app/config.py) -------------------------------------------
JWT_SECRET=<run: python3 -c "import secrets; print(secrets.token_urlsafe(32))">
OPENCODE_API_KEY=<your opencode api key>
OPENROUTER_API_KEY=<your openrouter api key>
OTEL_ENABLED=false

# --- Langfuse: app-side client (app/llm/langfuse_client.py) -----------------
# LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY must match the
# LANGFUSE_INIT_PROJECT_* pair below — that is what provisions them on the
# first `--profile langfuse` boot.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-<run: python3 -c "import uuid; print(uuid.uuid4())">
LANGFUSE_SECRET_KEY=sk-lf-<run: python3 -c "import uuid; print(uuid.uuid4())">
LANGFUSE_HOST=http://localhost:3400

# --- Langfuse: docker-compose secrets (profile `langfuse` only) -------------
# Generate each of these once and keep them stable — rotating
# LANGFUSE_ENCRYPTION_KEY or LANGFUSE_SALT makes already-stored data
# unreadable.
LANGFUSE_SALT=<run: python3 -c "import secrets; print(secrets.token_hex(16))">
# Must be exactly 64 hex characters (32 bytes).
LANGFUSE_ENCRYPTION_KEY=<run: python3 -c "import secrets; print(secrets.token_hex(32))">
LANGFUSE_NEXTAUTH_SECRET=<run: python3 -c "import secrets; print(secrets.token_hex(16))">
LANGFUSE_POSTGRES_PASSWORD=<run: python3 -c "import secrets; print(secrets.token_hex(16))">
LANGFUSE_CLICKHOUSE_PASSWORD=<run: python3 -c "import secrets; print(secrets.token_hex(16))">
LANGFUSE_REDIS_AUTH=<run: python3 -c "import secrets; print(secrets.token_hex(16))">
LANGFUSE_MINIO_ROOT_PASSWORD=<run: python3 -c "import secrets; print(secrets.token_hex(16))">

# --- Langfuse: first-boot provisioning (profile `langfuse` only) ------------
# Consumed by langfuse-web on an empty database to create the org, project,
# API key pair and login user, so no manual UI setup is needed.
LANGFUSE_INIT_ORG_ID=knovolve
LANGFUSE_INIT_ORG_NAME=Knovolve
LANGFUSE_INIT_PROJECT_ID=knovolve-backend
LANGFUSE_INIT_PROJECT_NAME=Knovolve Backend
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=<same value as LANGFUSE_PUBLIC_KEY above>
LANGFUSE_INIT_PROJECT_SECRET_KEY=<same value as LANGFUSE_SECRET_KEY above>
LANGFUSE_INIT_USER_EMAIL=<your email>
LANGFUSE_INIT_USER_NAME=<your name>
LANGFUSE_INIT_USER_PASSWORD=<a password, min 8 chars — this is your langfuse UI login>
